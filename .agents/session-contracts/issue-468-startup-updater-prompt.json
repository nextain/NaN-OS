  "goal": "Implement and validate naia-shell issue #468: a consent-gated startup update prompt with a version-specific 30-day reminder deferral.",
  "scope": [
    "Replace the lossy question-mark GitHub issue body with a UTF-8 Korean specification derived from the accepted requirements and tests",
    "Check for an available signed update once after startup and onboarding",
    "Show an accessible localized update prompt before any download or install",
    "Persist a version-specific 30-day reminder deferral and bypass it for newer versions",
    "Preserve the existing update banner and manual Settings update flow",
    "Add requirements, user scenarios, unit tests, and Playwright acceptance coverage"
  ],
  "non_goals": [
    "Change updater signing, release feeds, or update channels",
    "Enable self-updates for store-managed distributions such as Flatpak",
    "Install an update without explicit user confirmation",
    "Commit, push, or open a pull request without separate authorization"
  ],
  "success_criteria": [
    "GitHub issue #468 renders a readable Korean problem statement, behavior contract, acceptance checklist, and non-goals",
    "An available update opens one startup prompt and does not download before the user selects update",
    "Selecting Later without deferral leaves the existing banner available",
    "Selecting one-month deferral hides the same version for 30 days while a newer version remains visible",
    "Update check and install failures do not block application startup and are truthfully surfaced",
    "Targeted unit, build, i18n, structure, and Playwright checks pass"
